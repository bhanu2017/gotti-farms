# Copy this file to .env and fill in your values.

PORT=3000
NODE_ENV=development

# Store details shown on the website
STORE_NAME=Gotti Farms
STORE_PHONE=+91 98765 43210
STORE_EMAIL=info@gottifarms.com
# WhatsApp number with country code, digits only (used for the chat button)
STORE_WHATSAPP=919876543210

# Delivery charges (in rupees)
DELIVERY_FEE=40
FREE_DELIVERY_ABOVE=499

# Cash on delivery: true or false
COD_ENABLED=true

# Admin panel login (open /admin). Use a long password.
ADMIN_PASSWORD=change-this-to-a-long-password
# Random string used to sign admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Razorpay (https://dashboard.razorpay.com -> Account & Settings -> API Keys)
# Use rzp_test_ keys while testing and rzp_live_ keys when you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this when you create a webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# Where the database file is stored
DB_PATH=./data/store.db
