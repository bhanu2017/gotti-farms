# For local testing with `netlify dev`: copy this file to .env and fill it in.
# On the live site, add the same names in Netlify: Site configuration -> Environment variables.

# Postgres connection string (Neon: use the "Pooled connection" string)
DATABASE_URL=

# Admin panel login (open /admin)
ADMIN_PASSWORD=
# Random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Store details shown on the website
STORE_NAME=Gotti Farms
STORE_PHONE=+91 98765 43210
STORE_EMAIL=info@gottifarms.com
STORE_WHATSAPP=919876543210

# Delivery charges (in rupees)
DELIVERY_FEE=40
FREE_DELIVERY_ABOVE=499
COD_ENABLED=true

# Razorpay (leave empty until you have live keys on the live site)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
